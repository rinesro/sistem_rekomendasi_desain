# Salin file ini menjadi .env lalu isi API key Gemini kamu. Cukup 1 baris ini saja
# yang wajib diisi. Dapatkan API key gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opsional — model sudah diset default ke gemini-2.5-flash (model stabil, kuota
# gratis lebih longgar dibanding model preview). Ganti kalau perlu, mis. kembali ke
# model preview terbaru (gemini-3-flash-preview) kalau kuotanya sudah mencukupi.
# GEMINI_MODEL=gemini-2.5-flash
