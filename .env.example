# Salin file ini menjadi .env lalu isi API key Gemini kamu.
# Dapatkan API key gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opsional, model default sudah diisi (boleh diganti sesuai model yang tersedia di akunmu)
GEMINI_RESEARCH_MODEL=gemini-2.5-flash
GEMINI_SYNTHESIS_MODEL=gemini-2.5-pro
