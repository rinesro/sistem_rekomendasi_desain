# Salin file ini menjadi .env lalu isi API key Gemini kamu. Cukup 1 baris ini saja
# yang wajib diisi. Dapatkan API key gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opsional — model sudah diset default ke Gemini 3 Flash, tidak perlu diubah kecuali
# kamu ingin memakai model Gemini lain.
# GEMINI_MODEL=gemini-3-flash-preview
